# ─────────────────────────────────────────────────────────────
# 사용법:
#   1) 이 파일을 application-secret.properties 로 복사한다
#      cp application-secret.properties.example application-secret.properties
#   2) 아래 값에 발급받은 키를 붙여넣는다
#   3) application-secret.properties 는 .gitignore 로 git 제외됨 — 절대 커밋 안 됨
#
#   ⚠️ 이 .example 파일에는 실제 키를 넣지 말 것 (이건 커밋되는 템플릿).
# ─────────────────────────────────────────────────────────────

# 공공데이터포털(data.go.kr) 일반 인증키
#   - Decoding(원본) 키 권장 — 클라이언트가 인코딩을 한 번만 하도록
#   - 발급: https://www.data.go.kr 로그인 > 마이페이지 > 오픈API > 인증키 발급
#   - 이 키 하나로 공용: 특일정보 · 국문관광정보(TourAPI) · 관광빅데이터 · TAGO · 코레일
DATA_GO_KR_SERVICE_KEY=

# TMAP appKey (SK openapi)
#   - 발급: https://openapi.sk.com 로그인 > 대시보드 > 앱 > appKey
TMAP_APP_KEY=

# Apidog Open API (─ /pr 커맨드가 PR 생성 시 OpenAPI 스펙을 apidog 로 자동 동기화 ─)
#   ⚠️ 앱 런타임과 무관한 개발 도구 시크릿 — Spring 은 이 키를 바인딩하지 않는다(무시).
#   - ACCESS_TOKEN: apidog 우상단 아바타 > Account Settings > API Access Token (발급 시 한 번만 표시)
#   - PROJECT_ID  : apidog 프로젝트 > Project Settings > Basic Settings
APIDOG_ACCESS_TOKEN=
APIDOG_PROJECT_ID=

# 디스코드 알림 웹훅 URL (외부 API 한도 알림 · 정책 만료 알림)
#   ⚠️ URL 끝 token 조각을 아는 사람은 누구나 그 채널에 글을 쓸 수 있다 — 비밀로 다룬다.
#   - 발급: 디스코드 채널 > 채널 편집 > 연동 > 웹훅 > 새 웹훅 > 웹훅 URL 복사
#   - prod 프로파일에서만 실제로 전송한다. 로컬은 같은 문구를 로그로만 남긴다.
DISCORD_WEBHOOK_URL=

# FCM 발송 자격증명 — Firebase 서비스 계정 비공개 키(JSON)를 base64 로 한 줄로
#   ⚠️ 앱이 쓰는 GoogleService-Info.plist·google-services.json 이 아니다. 그건 클라이언트 설정이고
#      서버는 발송 권한이 있는 서비스 계정 키가 필요하다. project_id 가 우리 프로젝트인지 확인한다.
#   - 발급: Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
#   - 변환: base64 -i <다운로드한.json> | tr -d '\n'
#   - 비면 발송하지 않고 뜬다(PushResult.DISABLED). 부팅은 막지 않는다.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# 서비스 계정 JSON 파일 경로 — 로컬에서 base64 대신 쓸 수 있다(선택)
#   둘 다 있으면 base64 가 이긴다.
FIREBASE_SERVICE_ACCOUNT_PATH=

# 네이버 클라우드 플랫폼 Maps — 좌표 지오코딩에 쓴다
#   ⚠️ 서버 런타임이 아니라 scripts/build_heritage_pool.py 가 쓴다(국가유산 풀의 좌표 보강).
#      없으면 그 스크립트의 지오코딩 단계만 멈춘다 — 서버 부팅·동작과 무관하다.
#   - 발급: https://console.ncloud.com > AI·NAVER API > Maps > 인증 정보
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
