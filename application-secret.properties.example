# ─────────────────────────────────────────────────────────────
# 사용법:
#   1) 이 파일을 application-secret.properties 로 복사한다
#      cp application-secret.properties.example application-secret.properties
#   2) 아래 값에 발급받은 키를 붙여넣는다
#   3) application-secret.properties 는 .gitignore 로 git 제외됨 — 절대 커밋 안 됨
#
#   ⚠️ 이 .example 파일에는 실제 키를 넣지 말 것 (이건 커밋되는 템플릿).
# ─────────────────────────────────────────────────────────────

# 공공데이터포털(data.go.kr) 일반 인증키
#   - Decoding(원본) 키 권장 — 클라이언트가 인코딩을 한 번만 하도록
#   - 발급: https://www.data.go.kr 로그인 > 마이페이지 > 오픈API > 인증키 발급
#   - 이 키 하나로 공용: 특일정보 · 국문관광정보(TourAPI) · 관광빅데이터 · TAGO · 코레일
DATA_GO_KR_SERVICE_KEY=

# TMAP appKey (SK openapi)
#   - 발급: https://openapi.sk.com 로그인 > 대시보드 > 앱 > appKey
TMAP_APP_KEY=

# Apidog Open API (─ /pr 커맨드가 PR 생성 시 OpenAPI 스펙을 apidog 로 자동 동기화 ─)
#   ⚠️ 앱 런타임과 무관한 개발 도구 시크릿 — Spring 은 이 키를 바인딩하지 않는다(무시).
#   - ACCESS_TOKEN: apidog 우상단 아바타 > Account Settings > API Access Token (발급 시 한 번만 표시)
#   - PROJECT_ID  : apidog 프로젝트 > Project Settings > Basic Settings
APIDOG_ACCESS_TOKEN=
APIDOG_PROJECT_ID=

# ── 소셜 로그인 (#34) ─────────────────────────────────────────
#   비어 있어도 부팅된다 — 해당 provider 로그인만 USER-002 로 실패한다(로컬 실행성 규칙).
#   로컬에서 실 provider 토큰 없이 API 를 부르려면 POST /api/v1/auth/dev-login 을 쓴다(local 전용).

# 자체 JWT 서명키 (HS256, 최소 32바이트)
#   ⚠️ 이 값을 아는 사람은 아무 사용자의 토큰이나 위조할 수 있다.
#   - local 은 application-local.properties 의 개발용 고정값이 쓰이므로 비워둬도 된다.
#   - 운영은 반드시 주입한다. 없으면 부팅이 실패한다(조용히 약한 키로 뜨지 않게).
#   - 생성: openssl rand -base64 48
JWT_SECRET=

# 카카오 REST API 키
#   - 발급: https://developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
#   - 서버는 이 키로 카카오를 부르지 않는다(프로필 조회는 사용자 액세스 토큰만 받는다).
#     앱이 등록됐는지 판별하는 용도라, 비면 카카오 로그인을 받지 않는다.
#   - client secret 은 필요 없다. 그 값이 쓰이는 토큰 엔드포인트(POST /oauth/token)는 앱이 SDK 로 끝낸다.
KAKAO_REST_API_KEY=

# 카카오 앱 번호 (앱 ID) — Apple 의 APPLE_SERVICE_ID · 구글의 GOOGLE_WEB_CLIENT_ID 와 같은 역할이다
#   ⚠️ 이 값이 비면 카카오 로그인을 아예 받지 않는다. 조용히 검증을 건너뛰지 않기 위해서다.
#      검증이 없으면 **다른 카카오 앱에서 발급된 액세스 토큰**을 그대로 우리 서버에 던져 그 사용자로
#      로그인할 수 있다 — 토큰 하나만 손에 넣으면 되는 계정 탈취다.
#   - 확인: https://developers.kakao.com > 내 애플리케이션 > 앱 설정 > 요약 정보 > 앱 ID (숫자)
#   - REST API 키가 아니다. 서버는 토큰 정보 조회(/v1/user/access_token_info)가 돌려주는 app_id 와 이 값을 대조한다.
KAKAO_APP_ID=

# 구글 audience — ID 토큰의 aud 와 대조한다. 콤마로 여러 개.
#   ⚠️ 앱의 로그인 방식에 따라 오는 값이 다르다. 하나만 넣으면 그 경로가 전부 401 이 된다.
#        serverClientID 지정 → aud = '웹' 클라이언트 ID
#        지정 안 함          → aud = 'iOS' 클라이언트 ID
#      우리 프로젝트의 클라이언트 ID 를 전부 나열한다. 전부 우리 것이라 남의 앱 토큰은 그대로 걸린다.
#   - 발급: https://console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID
#   - iOS 것은 앱의 GoogleService-Info.plist 의 CLIENT_ID 와 같다
GOOGLE_AUDIENCES=

# 애플 audience — identityToken 의 aud 와 대조한다. 콤마로 여러 개.
#   ⚠️ Service ID 만 넣으면 iOS 네이티브 로그인이 전부 401 이 된다. 둘은 다른 값이다.
#        네이티브(ASAuthorizationAppleIDProvider) → aud = 앱 Bundle ID    (예: com.nth.offway)
#        웹·Android                              → aud = Service ID      (예: com.nth.offway.service)
#   - Service ID 발급: https://developer.apple.com > Identifiers > Services IDs
#   - Bundle ID 는 앱의 GoogleService-Info.plist 의 BUNDLE_ID 또는 Xcode 프로젝트 설정에서 확인
APPLE_AUDIENCES=

# 애플 서버 인증용 (지금은 미사용 — 회원 탈퇴 시 Apple 연결 해제(revoke)에 필요해 미리 받아 둔다)
#   ⚠️ APPLE_PRIVATE_KEY_BASE64 는 .p8 키 파일을 base64 로 인코딩한 값이다.
#      env-file 이 여러 줄 값을 못 받아 한 줄로 만든 것이라, 쓸 때 디코딩한다.
#      원본 .p8 은 재발급이 안 된다 — 레포에 두지 말 것(.gitignore 가 *.p8 을 막는다).
#   - 생성: base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
#   - 발급: https://developer.apple.com > Keys > Sign in with Apple 활성화한 키
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=

# 디스코드 알림 웹훅 URL (외부 API 한도 알림 · 정책 만료 알림)
#   ⚠️ URL 끝 token 조각을 아는 사람은 누구나 그 채널에 글을 쓸 수 있다 — 비밀로 다룬다.
#   - 발급: 디스코드 채널 > 채널 편집 > 연동 > 웹훅 > 새 웹훅 > 웹훅 URL 복사
#   - prod 프로파일에서만 실제로 전송한다. 로컬은 같은 문구를 로그로만 남긴다.
DISCORD_WEBHOOK_URL=

# 실측 스크립트(scripts/measure_tour_latency.py)가 소비한 외부 API 한도를 보고할 웹훅 URL
#   앱 런타임과 무관한 개발도구 시크릿이라 Spring 은 무시한다. 위와 같은 채널이어도 되고 달라도 된다.
#   비면 스크립트가 보고만 건너뛰고 측정은 그대로 진행한다.
DISCORD_MEASURE_WEBHOOK_URL=

# FCM 발송 자격증명 — Firebase 서비스 계정 비공개 키(JSON)를 base64 로 한 줄로
#   ⚠️ 앱이 쓰는 GoogleService-Info.plist·google-services.json 이 아니다. 그건 클라이언트 설정이고
#      서버는 발송 권한이 있는 서비스 계정 키가 필요하다. project_id 가 우리 프로젝트인지 확인한다.
#   - 발급: Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
#   - 변환: base64 -i <다운로드한.json> | tr -d '\n'
#   - 비면 발송하지 않고 뜬다(PushResult.DISABLED). 부팅은 막지 않는다.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# 서비스 계정 JSON 파일 경로 — 로컬에서 base64 대신 쓸 수 있다(선택)
#   둘 다 있으면 base64 가 이긴다.
FIREBASE_SERVICE_ACCOUNT_PATH=

# 네이버 클라우드 플랫폼 Maps — 좌표 지오코딩에 쓴다
#   ⚠️ 서버 런타임이 아니라 scripts/build_heritage_pool.py 가 쓴다(국가유산 풀의 좌표 보강).
#      없으면 그 스크립트의 지오코딩 단계만 멈춘다 — 서버 부팅·동작과 무관하다.
#   - 발급: https://console.ncloud.com > AI·NAVER API > Maps > 인증 정보
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
